# Copy this file to ".env" and fill in the values you want to use.
# Nothing in this file is required to run the app in Demo Mode.
# The app also lets you enter/edit all of this from the Settings UI;
# values entered there are encrypted and stored in the local database
# instead of in this file. This file is the "developer" / first-run path.

# ---------------------------------------------------------------------------
# General
# ---------------------------------------------------------------------------
# Runs the app with bundled sample data (resume, jobs, matches) and never
# calls any external network/API. Great for trying the app with no setup.
AIJF_DEMO_MODE=true

# Where local data (SQLite DB, logs, uploaded resumes) is stored.
# Defaults to %LOCALAPPDATA%\AIJobFinder if unset.
# AIJF_DATA_DIR=C:\Users\me\AIJobFinderData

# ---------------------------------------------------------------------------
# AI providers (all optional - leave blank to use local-only processing)
# ---------------------------------------------------------------------------
# Embedding provider: "local" (sentence-transformers, no key needed),
# "openai", or "voyage" (Anthropic has no embeddings API of its own -
# Voyage AI is the provider Anthropic recommends for embeddings).
AIJF_EMBEDDING_PROVIDER=local
AIJF_EMBEDDING_MODEL=all-MiniLM-L6-v2

# LLM provider. Drives automatic company discovery (the app finding
# employers that match your resume by itself), match reasoning on the
# final shortlist, and optional AI resume reading.
#   none      - off; scanning/matching/email still work, but the app
#               can't go find companies for you
#   anthropic - Claude          (ANTHROPIC_API_KEY)
#   openai    - GPT             (OPENAI_API_KEY)
#   gemini    - Google Gemini   (GEMINI_API_KEY; has a free tier)
#   local     - a model on YOUR OWN machine, no key, no cost - see below
AIJF_LLM_PROVIDER=none
AIJF_LLM_MODEL=claude-sonnet-5

# API keys - never commit real values. Leave blank if not using that provider.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
VOYAGE_API_KEY=

# Only used when AIJF_LLM_PROVIDER=local. Points at a model running on
# this computer via its OpenAI-compatible endpoint - no API key, no cost,
# nothing ever leaves the machine. Works with Ollama (default shown
# below), LM Studio, llama.cpp's server, or anything else that speaks
# the same protocol. Set AIJF_LLM_MODEL to the model name you've pulled,
# e.g. "llama3.1" or "mistral" - not a real model name is guessed here on
# purpose, since a wrong guess fails in a confusing way.
AIJF_LOCAL_LLM_BASE_URL=http://localhost:11434/v1

# ---------------------------------------------------------------------------
# Email (used by the daily-report sender - app/email/)
# These are just fallback defaults; the Email Settings page in the app
# lets you set/override all of these per-value, encrypted at rest.
# ---------------------------------------------------------------------------
AIJF_SMTP_HOST=smtp.gmail.com
AIJF_SMTP_PORT=587
AIJF_SMTP_USERNAME=
# Use an app-specific password, never your real account password.
AIJF_SMTP_APP_PASSWORD=
AIJF_EMAIL_FROM=
AIJF_EMAIL_TO=

# ---------------------------------------------------------------------------
# App updates
# ---------------------------------------------------------------------------
# URL of a small static JSON file describing the latest released version,
# e.g. {"version": "0.2.0", "download_url": "https://.../Setup.exe",
#       "notes": "What changed"}. When set, the app mentions available
# updates in the daily email and on the Settings page (it never downloads
# or installs anything itself). Leave blank and the app never checks.
# AIJF_UPDATE_MANIFEST_URL=https://example.com/aijobfinder-latest.json

# ---------------------------------------------------------------------------
# Security
# ---------------------------------------------------------------------------
# Fernet key used to encrypt secrets stored in the local database.
# Leave blank to have the app generate and persist one automatically on
# first run (recommended). Only set this manually if you need a stable key
# across reinstalls (e.g. restoring from backup).
# AIJF_ENCRYPTION_KEY=

